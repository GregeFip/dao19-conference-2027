{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dao-conference-2027",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dao-conference-2027",
      "database_id": "ce558ad5-d088-4cc6-83ad-dc9dda84fed7",
      "migrations_dir": "drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MEDIA",
      "id": "4ca457d0e4144b5eb93ba98f0b05ac0e"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "19202701",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "REGISTRATION_RATE_LIMITER",
      "namespace_id": "19202702",
      "simple": { "limit": 4, "period": 60 }
    }
  ]
}
